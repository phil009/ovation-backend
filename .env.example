# Copy to .env and fill in. Never commit .env. Checked at startup: the app refuses to start if something is wrong.

NODE_ENV=development

# Postgres from docker-compose.yaml (host port 15432 avoids Windows reserved port ranges)
DATABASE_URL=postgresql://ovation:ovation_dev@localhost:15432/ovation

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Used by `pnpm db:seed` to create the first account and an organisation it administers
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=Demo organisation

# Optional
PORT=5000

# Frontend origins allowed to call the API from a browser, comma-separated. Required when NODE_ENV=production.
# Leave empty in development to allow any origin.
CORS_ORIGINS=

# Behind a proxy or load balancer, so rate limits see the real client IP (usually 1)
TRUST_PROXY=

# Requests per minute per caller: everything / login, register, refresh and invite codes
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Set to false to switch off GET /api/sdk/typescript.zip (e.g. in production)
SDK_DOWNLOAD_ENABLED=true

# NestJS Observe (written by `npx @nestjs/observe link`). Set OBSERVE_ENABLED=false to stop reporting.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_ENABLED=true
