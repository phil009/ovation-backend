// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// setting up the schema for the users, events, awards and payment modes

/**
 * WHAT KIND OF USER IS THIS?
 * ADMINS -
 * EDITOR -
 * VIEWER -
 */
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum PaymentMode {
  CASH
  TRANSFER
  PLEDGE
}

enum DonationStatus {
  PLEDGED
  RECEIVED
}

/// An account. What a user may do is decided per organisation, by their Membership role.
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  donations     Donation[]
  auditLogs     AuditLog[]
  memberships   Membership[]
  refreshTokens RefreshToken[]
  invitesMade   InviteCode[]

  @@map("users")
}

/// A customer: a town union, church, association... Owns its events.
model Organization {
  id          String       @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  events      Event[]
  inviteCodes InviteCode[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// A user's place in an organisation, with their role there.
model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// A shareable code that lets anyone with an account join an organisation with a set role.
model InviteCode {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String       @unique
  role           Role
  maxUses        Int?
  uses           Int          @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("invite_codes")
}

/// One login session. Only a SHA-256 hash of the token is stored; each refresh replaces it.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  date           DateTime
  closed         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  awardees       Awardee[]
  donations      Donation[]

  @@index([organizationId])
  @@map("events")
}

model Awardee {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id])
  number      Int?
  name        String
  amountKobo  BigInt       @default(0)
  paymentMode PaymentMode?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  donations   Donation[]

  @@index([eventId])
  @@map("awardees")
}

model Donation {
  id          String         @id
  eventId     String
  event       Event          @relation(fields: [eventId], references: [id])
  awardeeId   String?
  awardee     Awardee?       @relation(fields: [awardeeId], references: [id])
  donorName   String
  amountKobo  BigInt
  paymentMode PaymentMode
  status      DonationStatus @default(RECEIVED)
  needsReview Boolean        @default(false)
  note        String?
  version     Int            @default(1)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([eventId, awardeeId])
  @@index([donorName])
  @@map("donations")
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  /// The organisation the change belongs to (null for account-level actions).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_log")
}
